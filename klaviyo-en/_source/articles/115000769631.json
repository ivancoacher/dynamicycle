    "name": "How to create email frequency segments",
    "title": "How to create email frequency segments",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-05T23:04:27Z",
