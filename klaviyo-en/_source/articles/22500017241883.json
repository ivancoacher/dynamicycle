    "name": "How to add Klaviyo Reviews widgets to your mobile app using Tapcart",
    "title": "How to add Klaviyo Reviews widgets to your mobile app using Tapcart",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:49:29Z",
