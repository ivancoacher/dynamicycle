    "name": "How to use ticket tagging in Helpdesk",
    "title": "How to use ticket tagging in Helpdesk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:54Z",
