    "name": "Understanding content age-gating for SMS",
    "title": "Understanding content age-gating for SMS",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:18Z",
