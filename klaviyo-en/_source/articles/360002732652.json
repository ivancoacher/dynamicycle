    "name": "How to create a date property-triggered flow",
    "title": "How to create a date property-triggered flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-27T21:16:46Z",
