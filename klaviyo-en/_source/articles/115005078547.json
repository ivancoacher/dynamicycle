    "name": "How to find the subscribe link for a list",
    "title": "How to find the subscribe link for a list",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-10-27T15:16:14Z",
