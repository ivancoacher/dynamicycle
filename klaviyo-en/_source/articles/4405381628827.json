    "name": "Understanding sign-up form dismissal settings",
    "title": "Understanding sign-up form dismissal settings",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:59Z",
