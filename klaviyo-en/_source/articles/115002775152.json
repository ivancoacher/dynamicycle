    "name": "How to A/B test a flow email (deprecated)",
    "title": "How to A/B test a flow email (deprecated)",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2022-09-20T22:48:16Z",
