        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/6456860853275-MMS-throughput-in-the-US-Canada-and-Australia#h_01HRCHAPATQ4HQ67007TW17SZD",
          "text": "What is throughput?"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/6456860853275-MMS-throughput-in-the-US-Canada-and-Australia#h_01HRCHAPAT7QXEEFH329J2QZB5",
          "text": "How throughput for MMS works"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/6456860853275-MMS-throughput-in-the-US-Canada-and-Australia#h_01HRCHAPAT3GZ5RM06NDHSMQVV",
          "text": "Canada’s hard limit on MMS"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/6456860853275-MMS-throughput-in-the-US-Canada-and-Australia#h_01HRCHAPAT5S9GW74RSWM1YKSD",
          "text": "Best practices for MMS"
