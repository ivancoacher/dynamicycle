    "name": "How to add a tag to a campaign or flow",
    "title": "How to add a tag to a campaign or flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-19T21:07:57Z",
