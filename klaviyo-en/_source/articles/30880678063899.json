    "name": "How to message BigCommerce customers by storefront",
    "title": "How to message BigCommerce customers by storefront",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:53Z",
