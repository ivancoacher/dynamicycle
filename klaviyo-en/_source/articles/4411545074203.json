    "name": "How to edit or reschedule a campaign",
    "title": "How to edit or reschedule a campaign",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:31Z",
