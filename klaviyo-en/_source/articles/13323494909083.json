    "name": "How to create an abandoned cart flow for Shopware",
    "title": "How to create an abandoned cart flow for Shopware",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-12-08T17:27:06Z",
