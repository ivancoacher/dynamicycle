    "name": "How to leverage favorites in flows",
    "title": "How to leverage favorites in flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-02T15:47:34Z",
    "user_segment_id": null,
