    "name": "Constant Contact data reference",
    "title": "Constant Contact data reference",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-12-03T15:57:05Z",
