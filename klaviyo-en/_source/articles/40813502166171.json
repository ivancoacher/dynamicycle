    "name": "Klaviyo Helpdesk: Tag, Segment, and List routing",
    "title": "Klaviyo Helpdesk: Tag, Segment, and List routing",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:23Z",
