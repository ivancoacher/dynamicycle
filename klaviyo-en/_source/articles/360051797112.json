    "name": "Understanding how Klaviyo converts currency in Benchmarks",
    "title": "Understanding how Klaviyo converts currency in Benchmarks",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-24T20:30:43Z",
