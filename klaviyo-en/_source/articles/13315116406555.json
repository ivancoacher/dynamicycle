    "name": "Understanding Klaviyo's search bar functionality",
    "title": "Understanding Klaviyo's search bar functionality",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:47Z",
