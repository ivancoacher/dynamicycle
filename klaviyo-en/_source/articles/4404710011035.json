    "name": "When Klaviyo removes SMS consent automatically",
    "title": "When Klaviyo removes SMS consent automatically",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:55Z",
