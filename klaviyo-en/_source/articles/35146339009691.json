    "name": "How to use custom objects in segments",
    "title": "How to use custom objects in segments",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-25T16:54:16Z",
