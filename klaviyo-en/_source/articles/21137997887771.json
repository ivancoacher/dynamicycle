    "name": "How to create an abandoned site flow with email and SMS",
    "title": "How to create an abandoned site flow with email and SMS",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-12-01T22:20:24Z",
