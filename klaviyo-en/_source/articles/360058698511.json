    "name": "How to collect SMS consent at checkout on Magento 2",
    "title": "How to collect SMS consent at checkout on Magento 2",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-21T15:46:25Z",
