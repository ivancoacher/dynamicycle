    "name": "How to embed a sign-up form on your BigCommerce order confirmation page",
    "title": "How to embed a sign-up form on your BigCommerce order confirmation page",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-26T17:56:23Z",
