        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43956692620059-How-to-add-a-Favorites-link-icon-text-or-button-to-your-Shopify-header#h_01KBGBE11TW3NDEB8NY8QT68WF",
          "text": "Before you begin"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43956692620059-How-to-add-a-Favorites-link-icon-text-or-button-to-your-Shopify-header#h_01KBGBE11W7E0G56NZ1FPHF5M5",
          "text": "Step 1: Prepare your assets (if you want to use an icon)"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43956692620059-How-to-add-a-Favorites-link-icon-text-or-button-to-your-Shopify-header#h_01KBGBE11Z54TAQCSTQG501Q7J",
          "text": "Step 2: Insert the header (top navigation bar) link"
