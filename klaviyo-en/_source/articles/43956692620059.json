    "name": "How to add a Favorites link (icon, text, or button) to your Shopify header",
    "title": "How to add a Favorites link (icon, text, or button) to your Shopify header",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:15Z",
