    "name": "How to optimize popup and flyout forms for mobile",
    "title": "How to optimize popup and flyout forms for mobile",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:03Z",
