    "name": "How to run a contest or giveaway using subscribe pages",
    "title": "How to run a contest or giveaway using subscribe pages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-25T19:08:15Z",
