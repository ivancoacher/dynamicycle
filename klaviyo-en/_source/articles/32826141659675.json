    "name": "How to create an unengaged segment",
    "title": "How to create an unengaged segment",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-30T15:01:11Z",
