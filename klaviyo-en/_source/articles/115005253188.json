    "name": "How to configure out-of-stock items for automated flows on Shopify",
    "title": "How to configure out-of-stock items for automated flows on Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-02T15:48:52Z",
