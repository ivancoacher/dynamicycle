    "name": "Understanding custom hosted pages in Klaviyo",
    "title": "Understanding custom hosted pages in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-03-14T18:30:40Z",
