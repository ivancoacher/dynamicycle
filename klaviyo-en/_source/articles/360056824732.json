    "name": "How to collect SMS marketing consent at checkout on Shopify",
    "title": "How to collect SMS marketing consent at checkout on Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-16T19:05:59Z",
