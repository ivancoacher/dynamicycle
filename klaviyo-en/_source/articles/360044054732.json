    "name": "How to clean your email list to maintain good deliverability",
    "title": "How to clean your email list to maintain good deliverability",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-07T15:21:30Z",
