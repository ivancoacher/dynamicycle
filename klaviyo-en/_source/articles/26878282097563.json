    "name": "How to create an SMS form that targets email subscribers",
    "title": "How to create an SMS form that targets email subscribers",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-12T14:56:19Z",
