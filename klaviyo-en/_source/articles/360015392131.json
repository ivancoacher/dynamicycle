    "name": "How to add Klaviyo onsite tracking using Google Tag Manager",
    "title": "How to add Klaviyo onsite tracking using Google Tag Manager",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-08-29T15:40:10Z",
