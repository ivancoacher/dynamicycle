    "name": "How to use Shopify tags to filter customers",
    "title": "How to use Shopify tags to filter customers",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-07-16T16:25:35Z",
