    "name": "Troubleshooting custom CSS, JavaScript, and HTML in Klaviyo",
    "title": "Troubleshooting custom CSS, JavaScript, and HTML in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-27T16:57:49Z",
