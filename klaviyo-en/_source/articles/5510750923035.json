    "name": "Troubleshooting your Magento 2 integration",
    "title": "Troubleshooting your Magento 2 integration",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:07Z",
