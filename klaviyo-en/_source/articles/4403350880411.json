    "name": "How to manually enable OAuth for Magento 2 v2.2.0 and older",
    "title": "How to manually enable OAuth for Magento 2 v2.2.0 and older",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:32Z",
