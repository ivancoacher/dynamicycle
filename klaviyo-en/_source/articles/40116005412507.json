    "name": "How to get a phone number for WhatsApp",
    "title": "How to get a phone number for WhatsApp",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:50:23Z",
    "user_segment_id": null,
