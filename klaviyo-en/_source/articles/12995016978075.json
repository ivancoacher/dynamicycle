    "name": "How to strengthen your sender reputation for a specific country",
    "title": "How to strengthen your sender reputation for a specific country",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-06-07T18:26:11Z",
