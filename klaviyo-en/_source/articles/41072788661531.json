    "name": "How to create rich interactive RCS messages in Klaviyo",
    "title": "How to create rich interactive RCS messages in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:36Z",
