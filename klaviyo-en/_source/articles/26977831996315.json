    "name": "Understanding the opt-out options for an SMS message",
    "title": "Understanding the opt-out options for an SMS message",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-11-04T13:52:19Z",
    "user_segment_id": null,
