    "name": "How to add or remove an account from a portfolio",
    "title": "How to add or remove an account from a portfolio",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-04-30T15:15:16Z",
