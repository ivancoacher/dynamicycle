    "name": "How to create a not-opted-in segment",
    "title": "How to create a not-opted-in segment",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-24T18:23:07Z",
