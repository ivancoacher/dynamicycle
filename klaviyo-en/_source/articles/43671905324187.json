        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43671905324187-Automatically-prevent-over-messaging-with-omnichannel-campaigns-exit-criteria#h_01KAVTSBMB6XE24WPA62AQK0BX",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43671905324187-Automatically-prevent-over-messaging-with-omnichannel-campaigns-exit-criteria#h_01J41MZ18E6EYF9JK48Q2VC627",
          "text": "Before you begin"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43671905324187-Automatically-prevent-over-messaging-with-omnichannel-campaigns-exit-criteria#h_01J41MZ18EJWCBMDVVHDKWT3MA",
          "text": "How it works"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43671905324187-Automatically-prevent-over-messaging-with-omnichannel-campaigns-exit-criteria#h_01KAVTX5CZ4TQ94YFD5M5DC1C7",
          "text": "Example: Sneaker Drop Launch"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/43671905324187-Automatically-prevent-over-messaging-with-omnichannel-campaigns-exit-criteria#h_01KAVV99XYF09DWEWE4ZZSE5BG",
          "text": "Configure Exit Criteria"
