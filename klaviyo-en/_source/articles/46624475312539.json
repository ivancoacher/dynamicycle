    "name": "How to add WhatsApp to your browse abandonment flow",
    "title": "How to add WhatsApp to your browse abandonment flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:35Z",
