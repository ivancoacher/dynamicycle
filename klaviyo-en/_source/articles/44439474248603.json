    "name": "How to connect Loop Returns to Klaviyo Helpdesk",
    "title": "How to connect Loop Returns to Klaviyo Helpdesk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:51Z",
