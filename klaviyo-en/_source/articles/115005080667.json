    "name": "How to sync Shopify email subscribers to a Klaviyo list",
    "title": "How to sync Shopify email subscribers to a Klaviyo list",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-16T19:30:02Z",
