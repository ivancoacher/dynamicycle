    "name": "Understanding explicit vs. implicit consent",
    "title": "Understanding explicit vs. implicit consent",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:44Z",
