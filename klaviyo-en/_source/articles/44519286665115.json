    "name": "How to write a WhatsApp double opt-in template",
    "title": "How to write a WhatsApp double opt-in template",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:59Z",
