    "name": "How to create a winback flow for Amazon Buy with Prime",
    "title": "How to create a winback flow for Amazon Buy with Prime",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-12-08T17:05:32Z",
