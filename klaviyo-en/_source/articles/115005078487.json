    "name": "How to migrate existing email subscribers (and unsubscribes) into Klaviyo",
    "title": "How to migrate existing email subscribers (and unsubscribes) into Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-29T18:00:24Z",
