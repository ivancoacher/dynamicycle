    "name": "RCS on iOS: known limitations and what to expect",
    "title": "RCS on iOS: known limitations and what to expect",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:24Z",
