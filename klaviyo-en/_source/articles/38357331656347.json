    "name": "How to connect an order tracking provider to Customer Hub",
    "title": "How to connect an order tracking provider to Customer Hub",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-13T20:02:12Z",
