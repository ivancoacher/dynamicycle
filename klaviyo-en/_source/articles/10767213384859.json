    "name": "How to re-engage an old email list",
    "title": "How to re-engage an old email list",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-05-22T20:05:28Z",
