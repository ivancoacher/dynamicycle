    "name": "How to send a campaign to people skipped by a list-triggered flow",
    "title": "How to send a campaign to people skipped by a list-triggered flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-25T15:31:31Z",
