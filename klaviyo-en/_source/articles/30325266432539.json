        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/30325266432539-How-to-preview-a-profile-s-journey-through-a-flow#h_01JCRSEPH3K99W1KPMACT8WW2B",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/30325266432539-How-to-preview-a-profile-s-journey-through-a-flow#h_01JCRSEPH3YQXWFFCH4KVBY5ZC",
          "text": "Preview a flow"
