    "name": "How to preview a profile's journey through a flow",
    "title": "How to preview a profile's journey through a flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-02-13T16:46:08Z",
