        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/40939206649627-Understanding-data-warehouse-import-in-Klaviyo#h_01K5ZEDVJ4BWZYVKFG8YC09NHR",
          "text": "Introduction ."
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/40939206649627-Understanding-data-warehouse-import-in-Klaviyo#h_01K5ZEE23S26BSYC0RZZKE964H",
          "text": "How does data warehouse import in Klaviyo work?"
