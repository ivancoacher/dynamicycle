    "name": "How to manage email suppressions and delete profiles in bulk",
    "title": "How to manage email suppressions and delete profiles in bulk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:55Z",
