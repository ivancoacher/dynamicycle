    "name": "How to import profile properties using a CSV upload",
    "title": "How to import profile properties using a CSV upload",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-02-19T19:27:51Z",
