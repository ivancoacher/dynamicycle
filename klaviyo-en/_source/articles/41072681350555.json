    "name": "How to create an RCS message in a flow",
    "title": "How to create an RCS message in a flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:35Z",
