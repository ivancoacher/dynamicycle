    "name": "How to use Customer Hub with Shopify Markets",
    "title": "How to use Customer Hub with Shopify Markets",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:01Z",
