    "name": "How to view sign-up form responses",
    "title": "How to view sign-up form responses",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:04Z",
