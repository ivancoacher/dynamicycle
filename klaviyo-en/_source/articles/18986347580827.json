    "name": "How to add personalization to your messages",
    "title": "How to add personalization to your messages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:54Z",
