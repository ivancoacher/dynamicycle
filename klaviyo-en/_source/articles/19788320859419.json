    "name": "How to prevent multiple sign-up forms from displaying at once",
    "title": "How to prevent multiple sign-up forms from displaying at once",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-28T16:17:02Z",
