    "name": "How to set up extended ID cookie tracking",
    "title": "How to set up extended ID cookie tracking",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:54Z",
