        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/38311213022235-Mews-data-reference#h_01K0YHVJP0NQ5RW838MJDETT7V",
          "text": "How to view your Mews data"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/38311213022235-Mews-data-reference#h_01K45A368Q03V7W6X9XCHQRAEM",
          "text": "Room Night metrics"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/38311213022235-Mews-data-reference#h_01K0YHVJP027BJQ2MJ8X3V0HZW",
          "text": "Reservation metrics"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/38311213022235-Mews-data-reference#h_01KG3E1KDVY6ARFQR57V8J9Q2B",
          "text": "Reservation objects"
