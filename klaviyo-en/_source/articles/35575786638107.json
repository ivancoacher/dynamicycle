    "name": "April 11 SMS opt-out compliance change",
    "title": "April 11 SMS opt-out compliance change",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:53Z",
