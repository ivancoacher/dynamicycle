    "name": "How to disable notification emails sent by Shopify",
    "title": "How to disable notification emails sent by Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:36Z",
