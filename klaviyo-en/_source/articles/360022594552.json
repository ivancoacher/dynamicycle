    "name": "How to add a Klaviyo embed form to your BigCommerce site",
    "title": "How to add a Klaviyo embed form to your BigCommerce site",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-27T18:03:47Z",
