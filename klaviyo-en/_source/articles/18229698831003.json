    "name": "How to add a Klaviyo embed form to your Square Online site",
    "title": "How to add a Klaviyo embed form to your Square Online site",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-28T16:38:54Z",
