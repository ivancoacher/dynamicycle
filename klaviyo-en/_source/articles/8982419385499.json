    "name": "Understanding next steps after warming your email domain",
    "title": "Understanding next steps after warming your email domain",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:51Z",
