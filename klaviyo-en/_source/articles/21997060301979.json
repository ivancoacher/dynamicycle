        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/21997060301979-Push-notification-glossary#h_01HKZ4X451VDVNJKNQXANPW9GK",
          "text": "A"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/21997060301979-Push-notification-glossary#h_01HKZ4X451QC8SC1FQ0S0E7Q37",
          "text": "C"
