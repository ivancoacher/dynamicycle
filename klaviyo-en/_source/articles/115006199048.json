    "name": "How to delete, edit, view, or archive a campaign",
    "title": "How to delete, edit, view, or archive a campaign",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:48:34Z",
