        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/24016528108315-Getting-started-with-Intercom#h_01HYB7HB6VJPF95964BDYHXEJY",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/24016528108315-Getting-started-with-Intercom#h_01HYB7HB6VMWFRN5W1D92T7YMC",
          "text": "Before you begin"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/24016528108315-Getting-started-with-Intercom#h_01HYB7HB6V2K8K5J6JQZ3TRJ9V",
          "text": "Set up the Intercom integration"
