    "name": "How to resolve AT&T spam traps",
    "title": "How to resolve AT&T spam traps",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-10-20T13:49:43Z",
