    "name": "How to create a segment- or list-triggered flow",
    "title": "How to create a segment- or list-triggered flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:57:57Z",
