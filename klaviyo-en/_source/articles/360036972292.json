    "name": "Understanding the difference between email and SMS",
    "title": "Understanding the difference between email and SMS",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-14T20:19:45Z",
