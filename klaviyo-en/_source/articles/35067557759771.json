    "name": "How to collect transactional SMS consent on Shopify checkout pages",
    "title": "How to collect transactional SMS consent on Shopify checkout pages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:52Z",
