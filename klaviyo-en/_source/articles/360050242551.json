    "name": "How to opt in and out of an internal alert action",
    "title": "How to opt in and out of an internal alert action",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-25T19:59:33Z",
