    "name": "How to use dynamic blocks in forms",
    "title": "How to use dynamic blocks in forms",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-31T19:39:29Z",
