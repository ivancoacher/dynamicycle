    "name": "How to update a profile property when someone clicks a link",
    "title": "How to update a profile property when someone clicks a link",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-18T19:51:11Z",
