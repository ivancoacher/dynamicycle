    "name": "How to create follow-up messages in omnichannel campaigns",
    "title": "How to create follow-up messages in omnichannel campaigns",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:39Z",
