    "name": "How to review a flow email’s settings",
    "title": "How to review a flow email’s settings",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-25T20:37:25Z",
