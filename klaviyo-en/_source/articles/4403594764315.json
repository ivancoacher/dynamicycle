    "name": "How to disable notification emails sent by BigCommerce",
    "title": "How to disable notification emails sent by BigCommerce",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:37Z",
