    "name": "How to add an unsubscribe link to Klaviyo emails",
    "title": "How to add an unsubscribe link to Klaviyo emails",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:47Z",
