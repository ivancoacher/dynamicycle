    "name": "How to find and update your tax ID in Klaviyo",
    "title": "How to find and update your tax ID in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-06-06T20:12:56Z",
