    "name": "How to migrate to our automatic Added to Cart event for Shopify",
    "title": "How to migrate to our automatic Added to Cart event for Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:54Z",
