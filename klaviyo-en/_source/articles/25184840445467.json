    "name": "How to add historical Shopify SMS subscribers to your list",
    "title": "How to add historical Shopify SMS subscribers to your list",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-28T13:57:17Z",
