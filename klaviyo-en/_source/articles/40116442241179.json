    "name": "Understand WhatsApp billing in Klaviyo",
    "title": "Understand WhatsApp billing in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:06Z",
