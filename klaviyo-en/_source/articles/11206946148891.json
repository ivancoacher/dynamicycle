    "name": "How to add a countdown timer to a sign-up form",
    "title": "How to add a countdown timer to a sign-up form",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:47Z",
