    "name": "How to use a full page sign-up form as a landing page",
    "title": "How to use a full page sign-up form as a landing page",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:29Z",
