    "name": "How to collect SMS consent at checkout on PrestaShop",
    "title": "How to collect SMS consent at checkout on PrestaShop",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:52Z",
