    "name": "How to use Email AI to draft an email campaign",
    "title": "How to use Email AI to draft an email campaign",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:54Z",
