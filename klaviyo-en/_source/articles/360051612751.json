    "name": "How to configure back in stock alert emails",
    "title": "How to configure back in stock alert emails",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-09T14:28:46Z",
