    "name": "How to sync reviews to Meta Shops",
    "title": "How to sync reviews to Meta Shops",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:30Z",
