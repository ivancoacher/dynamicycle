    "name": "Magento 2 data reference",
    "title": "Magento 2 data reference",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-31T14:37:49Z",
