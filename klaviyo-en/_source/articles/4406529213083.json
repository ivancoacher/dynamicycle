        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4406529213083-How-to-resync-your-Shopify-catalog-feed#h_01HNAVE0C5VM0M4GSZRG2671ZP",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4406529213083-How-to-resync-your-Shopify-catalog-feed#h_01HNAVE0C6XVZY7VKTW1AVX2BW",
          "text": "Before you begin"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4406529213083-How-to-resync-your-Shopify-catalog-feed#h_01HNAVE0C63YF6CTTRK8FG5VTY",
          "text": "How to resync an individual item"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4406529213083-How-to-resync-your-Shopify-catalog-feed#h_01HNAVE0C6MJ17Z92GNJD5PFH1",
          "text": "How to resync a page of items"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4406529213083-How-to-resync-your-Shopify-catalog-feed#h_01HNAVE0C6HP3AVFG4A78HD670",
          "text": "How to refresh all category names"
