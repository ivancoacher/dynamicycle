    "name": "Understanding revenue metrics for sign-up forms",
    "title": "Understanding revenue metrics for sign-up forms",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:52Z",
