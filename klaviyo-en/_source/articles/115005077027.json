    "name": "How to configure Google Analytics event tracking for a sign-up form",
    "title": "How to configure Google Analytics event tracking for a sign-up form",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-12-10T15:48:06Z",
