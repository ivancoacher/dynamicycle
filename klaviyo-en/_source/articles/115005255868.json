    "name": "How to set up GoFundMe Pro campaigns and flows",
    "title": "How to set up GoFundMe Pro campaigns and flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-02-03T13:56:37Z",
