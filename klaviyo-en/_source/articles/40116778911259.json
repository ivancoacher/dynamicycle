    "name": "How to extend WhatsApp conversations",
    "title": "How to extend WhatsApp conversations",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:14Z",
