    "name": "How to ask for SMS consent within an email",
    "title": "How to ask for SMS consent within an email",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:44Z",
