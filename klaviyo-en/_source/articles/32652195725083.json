    "name": "How to create a churn prevention flow using RFM properties",
    "title": "How to create a churn prevention flow using RFM properties",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-20T16:59:02Z",
