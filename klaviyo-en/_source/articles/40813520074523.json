    "name": "Klaviyo Helpdesk:  Shopify Order Editing",
    "title": "Klaviyo Helpdesk:  Shopify Order Editing",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:24Z",
