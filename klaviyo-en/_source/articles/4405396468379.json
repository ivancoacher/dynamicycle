        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4405396468379-Understanding-fonts-in-email#h_01H8YA1P5VWPRH5XXJG348S8W6",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4405396468379-Understanding-fonts-in-email#h_01H8YA1P5V2Z6NKPSBTNAGZY3B",
          "text": "How fonts work"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/4405396468379-Understanding-fonts-in-email#h_01H8YA1P5W15WY5G8383TR6RZ3",
          "text": "How fonts work in email"
