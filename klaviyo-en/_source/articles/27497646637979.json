    "name": "How to configure custom reports to track bot clicks",
    "title": "How to configure custom reports to track bot clicks",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-10-01T16:03:36Z",
