    "name": "Deliverability vs. delivery for each channel",
    "title": "Deliverability vs. delivery for each channel",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-16T19:35:10Z",
