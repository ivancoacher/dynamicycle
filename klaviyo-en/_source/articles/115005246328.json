    "name": "How to send a personal email in Klaviyo",
    "title": "How to send a personal email in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-05T15:57:41Z",
