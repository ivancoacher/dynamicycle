    "name": "How to add a virtual contact card to a flow message",
    "title": "How to add a virtual contact card to a flow message",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:45Z",
