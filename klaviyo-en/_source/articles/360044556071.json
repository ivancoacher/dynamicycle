    "name": "How to create a sending schedule based on SMS engagement",
    "title": "How to create a sending schedule based on SMS engagement",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-06T17:56:34Z",
