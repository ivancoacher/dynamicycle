    "name": "Understanding Smart Sending in Klaviyo",
    "title": "Understanding Smart Sending in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-17T15:35:16Z",
