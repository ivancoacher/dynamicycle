    "name": "How to set up lead capture with Shop on a sign-up form",
    "title": "How to set up lead capture with Shop on a sign-up form",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:45Z",
