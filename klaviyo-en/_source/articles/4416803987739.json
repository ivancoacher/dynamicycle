    "name": "How to configure custom reports to track Apple Mail Privacy Protection (MPP) opens",
    "title": "How to configure custom reports to track Apple Mail Privacy Protection (MPP) opens",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:40Z",
