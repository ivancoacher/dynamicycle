        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/115002779331-How-to-manually-send-flow-messages-to-recipients#h_01HFCM24MKRJQZHXJ0G1E76AE6",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/115002779331-How-to-manually-send-flow-messages-to-recipients#h_01HFCM24MMXE4T4VJVR7K23TA9",
          "text": "About manual mode"
