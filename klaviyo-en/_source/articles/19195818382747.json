    "name": "Understanding when to prioritize an email, SMS, or mobile push",
    "title": "Understanding when to prioritize an email, SMS, or mobile push",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-23T20:52:23Z",
