    "name": "How to integrate with Zoho",
    "title": "How to integrate with Zoho",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-29T17:25:18Z",
