    "name": "How to create a value-based lookalike audience in Meta Ads",
    "title": "How to create a value-based lookalike audience in Meta Ads",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-24T14:49:21Z",
