    "name": "How to add WhatsApp to a flow",
    "title": "How to add WhatsApp to a flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:50:34Z",
