    "name": "How to create a branded shortened link for SMS",
    "title": "How to create a branded shortened link for SMS",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:47Z",
