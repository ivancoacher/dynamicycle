    "name": "How to create ADA-friendly sign-up forms",
    "title": "How to create ADA-friendly sign-up forms",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:46Z",
