    "name": "Understanding ramping vs. warming",
    "title": "Understanding ramping vs. warming",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:31Z",
