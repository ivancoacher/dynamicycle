    "name": "How to create an engaged segment of mobile push subscribers",
    "title": "How to create an engaged segment of mobile push subscribers",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-05T23:10:35Z",
