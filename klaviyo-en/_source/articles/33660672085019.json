    "name": "How to connect Smile.io to Customer Hub",
    "title": "How to connect Smile.io to Customer Hub",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:53Z",
