    "name": "How to use custom objects in templates",
    "title": "How to use custom objects in templates",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-02-20T13:33:11Z",
