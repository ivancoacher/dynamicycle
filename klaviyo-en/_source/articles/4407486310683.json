    "name": "How to send consent to Klaviyo via Zapier",
    "title": "How to send consent to Klaviyo via Zapier",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:10Z",
