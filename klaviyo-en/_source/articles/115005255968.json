    "name": "How to add a background image to an email template or section",
    "title": "How to add a background image to an email template or section",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-17T15:40:59Z",
