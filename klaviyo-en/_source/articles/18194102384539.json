    "name": "How to strategically use RFM properties in campaigns and flows",
    "title": "How to strategically use RFM properties in campaigns and flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-06-05T16:47:09Z",
