    "name": "Understanding Skills vs. Tools",
    "title": "Understanding Skills vs. Tools",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-29T20:13:56Z",
