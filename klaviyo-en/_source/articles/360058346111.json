    "name": "How to increase flow open rates",
    "title": "How to increase flow open rates",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-04-27T15:57:46Z",
