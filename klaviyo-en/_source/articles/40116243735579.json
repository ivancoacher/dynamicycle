    "name": "How to upload a list of WhatsApp contacts",
    "title": "How to upload a list of WhatsApp contacts",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:50:26Z",
