    "name": "How to create an SMS error segment",
    "title": "How to create an SMS error segment",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:04:05Z",
