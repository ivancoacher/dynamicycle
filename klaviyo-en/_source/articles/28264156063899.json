    "name": "How to use portfolio-level mapped metrics",
    "title": "How to use portfolio-level mapped metrics",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:55Z",
