    "name": "Understanding Gmail's tabbed inbox",
    "title": "Understanding Gmail's tabbed inbox",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-03-04T17:52:39Z",
