    "name": "How to request reviews from your customers with Klaviyo Reviews flows",
    "title": "How to request reviews from your customers with Klaviyo Reviews flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
