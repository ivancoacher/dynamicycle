        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/7872914223899-How-to-reset-your-Klaviyo-password#h_01HKWDQZAEWMXEMPZ9HCAG314Z",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/7872914223899-How-to-reset-your-Klaviyo-password#h_01JEC48P2BTC4ZBC39HNSQ83AC",
          "text": "Before you begin"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/7872914223899-How-to-reset-your-Klaviyo-password#h_01HKWDQZAFHAA31D3H60X2NVQW",
          "text": "Reset a forgotten password"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/7872914223899-How-to-reset-your-Klaviyo-password#h_01HKWDQZAF5A3Y8ADQX53JY7JJ",
          "text": "Still unable to log into your Klaviyo account?"
