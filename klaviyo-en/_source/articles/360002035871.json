    "name": "How to verify that sign-up forms are enabled",
    "title": "How to verify that sign-up forms are enabled",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-25T20:57:33Z",
