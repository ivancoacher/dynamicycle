    "name": "How to create a back in stock flow for Shopware",
    "title": "How to create a back in stock flow for Shopware",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-11-05T21:24:01Z",
