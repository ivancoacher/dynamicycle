    "name": "Understanding Magento 1 data in flows",
    "title": "Understanding Magento 1 data in flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-08-27T15:16:08Z",
