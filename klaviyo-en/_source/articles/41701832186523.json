    "name": "How to set up iOS universal links and Android App Links",
    "title": "How to set up iOS universal links and Android App Links",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:50:40Z",
