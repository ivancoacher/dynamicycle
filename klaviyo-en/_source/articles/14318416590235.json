    "name": "How to sync Meta lead ad subscribers to Klaviyo",
    "title": "How to sync Meta lead ad subscribers to Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:47Z",
