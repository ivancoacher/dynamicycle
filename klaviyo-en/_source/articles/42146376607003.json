    "name": "How to create a Click-to-WhatsApp ad with a “Subscribe” keyword",
    "title": "How to create a Click-to-WhatsApp ad with a “Subscribe” keyword",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:50:48Z",
