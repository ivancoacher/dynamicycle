    "name": "How to allow subscribers to opt out of Mother's Day, Father's Day, and other holiday messages",
    "title": "How to allow subscribers to opt out of Mother's Day, Father's Day, and other holiday messages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
