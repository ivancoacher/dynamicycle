    "name": "How to create a fulfilled partial order flow for Shopify",
    "title": "How to create a fulfilled partial order flow for Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:16Z",
