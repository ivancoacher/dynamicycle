    "name": "Understanding WhatsApp consent collection",
    "title": "Understanding WhatsApp consent collection",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:04Z",
