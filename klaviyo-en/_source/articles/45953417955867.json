    "name": "Ticket History: View and Manage Past Interactions",
    "title": "Ticket History: View and Manage Past Interactions",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:23Z",
