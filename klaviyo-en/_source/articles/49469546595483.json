    "name": "Create click-to-chat link for WhatsApp",
    "title": "Create click-to-chat link for WhatsApp",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-22T17:18:36Z",
