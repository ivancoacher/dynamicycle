    "name": "How to import product reviews data from another platform",
    "title": "How to import product reviews data from another platform",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:48:46Z",
