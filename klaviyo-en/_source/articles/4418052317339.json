    "name": "How to trigger a sign-up form to appear when a button is clicked",
    "title": "How to trigger a sign-up form to appear when a button is clicked",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:44Z",
