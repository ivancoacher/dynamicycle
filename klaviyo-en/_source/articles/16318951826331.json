    "name": "How to install Klaviyo Reviews on Shopify 2.0 themes",
    "title": "How to install Klaviyo Reviews on Shopify 2.0 themes",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
