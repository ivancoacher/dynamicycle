    "name": "How to update the Klaviyo branding in the footer of your emails",
    "title": "How to update the Klaviyo branding in the footer of your emails",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-12-01T08:00:06Z",
