    "name": "How to exclude lists or segments from a campaign send",
    "title": "How to exclude lists or segments from a campaign send",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:50:06Z",
