    "name": "How to use emojis in subject lines and email templates",
    "title": "How to use emojis in subject lines and email templates",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-11-01T16:28:48Z",
