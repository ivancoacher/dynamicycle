    "body": "<table>\n<tbody>\n<tr>\n<th style=\"text-align: left\">Dashboard</th>\n<th style=\"text-align: left\">Metric Used</th>\n<th style=\"text-align: left\">What It Shows</th>\n<th>Use Case</th>\n</tr>\n<tr>\n<td style=\"text-align: left\">Historical Daily Room Revenue from Stays</td>\n<td style=\"text-align: left\">Completed Room Night</td>\n<td style=\"text-align: left\">Total room revenue per night</td>\n<td>View the revenue attributable to each night</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">ADR from Stays</td>\n<td style=\"text-align: left\">Completed Room Night</td>\n<td style=\"text-align: left\">Average nightly rate for stays</td>\n<td>View the average daily rate historically</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">ADR from New Bookings</td>\n<td style=\"text-align: left\">Confirmed Room Night</td>\n<td style=\"text-align: left\">Average nightly rate at time of booking</td>\n<td>View the average daily rate for new bookings to understand the impact of marketing efforts</td>\n</tr>\n</tbody>\n</table>\n<table>\n<tbody>\n<tr>\n<th style=\"text-align: left\">Property</th>\n<th style=\"text-align: left\">What It Means</th>\n</tr>\n<tr>\n<td style=\"text-align: left\">$value</td>\n<td style=\"text-align: left\">The nightly room rate for that specific night</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">PropertyName</td>\n<td style=\"text-align: left\">The name of the hotel property</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">Origin</td>\n<td style=\"text-align: left\">Where the booking came from (e.g., Commander, ChannelManager, Connector)</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">ResourceName</td>\n<td style=\"text-align: left\">The room type or name (e.g., Executive Suite, Deluxe Queen)</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">StartDate</td>\n<td style=\"text-align: left\">The calendar date the night begins</td>\n</tr>\n</tbody>\n</table>",
