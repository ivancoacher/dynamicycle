    "name": "How to update your brand styles in Klaviyo",
    "title": "How to update your brand styles in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:35Z",
