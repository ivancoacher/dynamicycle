    "name": "How to create segments directly from funnels",
    "title": "How to create segments directly from funnels",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:01Z",
