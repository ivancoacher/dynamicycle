    "name": "How to add an embed form to your Shopify site",
    "title": "How to add an embed form to your Shopify site",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-30T20:21:32Z",
