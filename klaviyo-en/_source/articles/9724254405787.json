    "name": "How to change your notifications for new Inbox Helpdesk",
    "title": "How to change your notifications for new Inbox Helpdesk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:04:03Z",
