    "name": "How to bulk update or schedule flow statuses",
    "title": "How to bulk update or schedule flow statuses",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:12Z",
