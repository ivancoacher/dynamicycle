    "name": "How to transfer account ownership",
    "title": "How to transfer account ownership",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-09-30T16:08:52Z",
