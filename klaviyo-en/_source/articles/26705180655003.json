    "name": "How to request a long code in Klaviyo",
    "title": "How to request a long code in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-01-21T13:56:40Z",
