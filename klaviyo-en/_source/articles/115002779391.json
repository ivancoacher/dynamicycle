    "name": "How to create a third-party product review flow",
    "title": "How to create a third-party product review flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-10T23:37:57Z",
