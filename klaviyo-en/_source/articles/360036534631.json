    "name": "AND vs. OR reference",
    "title": "AND vs. OR reference",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-10-06T20:28:07Z",
    "user_segment_id": null,
