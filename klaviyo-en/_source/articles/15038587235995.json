    "name": "How to create a push welcome series",
    "title": "How to create a push welcome series",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-17T16:49:39Z",
