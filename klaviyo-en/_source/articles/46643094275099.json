    "name": "How to Add Klaviyo Onsite Tracking to Your Booking Engine",
    "title": "How to Add Klaviyo Onsite Tracking to Your Booking Engine",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-09T15:14:12Z",
