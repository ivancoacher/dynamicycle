    "name": "How to insert personalization into text blocks",
    "title": "How to insert personalization into text blocks",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:27Z",
