    "name": "How to preview a flow trigger setup",
    "title": "How to preview a flow trigger setup",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:04Z",
