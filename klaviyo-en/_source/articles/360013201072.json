    "name": "How to segment by customer lifetime value (CLV)",
    "title": "How to segment by customer lifetime value (CLV)",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-10-07T17:41:40Z",
