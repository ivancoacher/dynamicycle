    "name": "How to resend emails in Klaviyo",
    "title": "How to resend emails in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-05-01T12:23:21Z",
