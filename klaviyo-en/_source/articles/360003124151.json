    "name": "How to update Klaviyo after switching ecommerce platforms",
    "title": "How to update Klaviyo after switching ecommerce platforms",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-11T18:45:33Z",
