    "name": "How to identify and reactivate an inactive segment",
    "title": "How to identify and reactivate an inactive segment",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-02-13T16:43:41Z",
