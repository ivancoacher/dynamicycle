    "name": "How to install Klaviyo Reviews on Shopify (vintage themes and headless)",
    "title": "How to install Klaviyo Reviews on Shopify (vintage themes and headless)",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
