    "name": "How to use flows to send transactional emails",
    "title": "How to use flows to send transactional emails",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:57:59Z",
