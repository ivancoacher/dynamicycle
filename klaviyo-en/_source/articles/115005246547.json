    "name": "How to set up coupons (for Magento 1.x)",
    "title": "How to set up coupons (for Magento 1.x)",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-13T13:45:09Z",
