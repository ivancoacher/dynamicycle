    "name": "How to create a multilingual WhatsApp campaign using Smart Translations",
    "title": "How to create a multilingual WhatsApp campaign using Smart Translations",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:17Z",
