        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/360039666832-Understanding-the-subscribed-to-list-metric#h_01HFCJ0CJER735JCN1VFV08XFQ",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/360039666832-Understanding-the-subscribed-to-list-metric#h_01HFCJ0CJEA9S2B5GQ67N9H1V7",
          "text": "The subscribed to list metric"
