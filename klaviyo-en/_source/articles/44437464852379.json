    "name": "Klaviyo Helpdesk: How to send and receive media in a ticket",
    "title": "Klaviyo Helpdesk: How to send and receive media in a ticket",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:47Z",
