    "name": "Understanding how segment conditions evaluate null or empty values",
    "title": "Understanding how segment conditions evaluate null or empty values",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-27T15:06:48Z",
