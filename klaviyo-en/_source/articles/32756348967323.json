    "name": "How to create a nurture flow for RFM champions",
    "title": "How to create a nurture flow for RFM champions",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-20T16:59:02Z",
