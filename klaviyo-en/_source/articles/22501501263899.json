    "name": "How to change when a campaign's recipients are determined",
    "title": "How to change when a campaign's recipients are determined",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:49:30Z",
    "user_segment_id": null,
