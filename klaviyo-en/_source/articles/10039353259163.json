    "name": "How to use Klaviyo's SMS assistant",
    "title": "How to use Klaviyo's SMS assistant",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:45Z",
