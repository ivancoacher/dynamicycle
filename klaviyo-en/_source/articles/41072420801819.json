    "name": "How to create an RCS campaign in Klaviyo",
    "title": "How to create an RCS campaign in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-02-24T03:03:14Z",
    "user_segment_id": null,
