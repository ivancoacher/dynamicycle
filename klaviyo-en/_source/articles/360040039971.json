    "name": "How to create and send an SMS campaign",
    "title": "How to create and send an SMS campaign",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-31T18:51:24Z",
