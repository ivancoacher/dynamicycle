    "name": "How to reset multi-factor authentication for a user",
    "title": "How to reset multi-factor authentication for a user",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-06-10T15:22:56Z",
