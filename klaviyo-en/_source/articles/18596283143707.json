        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/18596283143707-How-to-add-a-dynamic-image-to-a-push-notification#additional-resources",
          "text": "Additional resources"
        },
        {
          "href": "https://forms.gle/7iPm6JQ4eKB6H2C4A",
          "text": "Google form"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/16917302437275",
          "text": "Understanding rich push notifications"
