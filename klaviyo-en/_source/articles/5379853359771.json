    "name": "How to remove onsite tracking for Shopify",
    "title": "How to remove onsite tracking for Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:03Z",
