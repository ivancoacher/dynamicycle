    "name": "How to grant a Klaviyo representative permission to your account",
    "title": "How to grant a Klaviyo representative permission to your account",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-12-19T18:28:47Z",
