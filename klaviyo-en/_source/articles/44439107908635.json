    "name": "How to Configure Advanced Routing Rules in Klaviyo Helpdesk",
    "title": "How to Configure Advanced Routing Rules in Klaviyo Helpdesk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:50Z",
