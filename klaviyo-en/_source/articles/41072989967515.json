    "name": "How to use the RCS capability property in Klaviyo",
    "title": "How to use the RCS capability property in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:37Z",
