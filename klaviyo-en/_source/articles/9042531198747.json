    "name": "How to migrate your branded sending domain from a previous email service provider (ESP) to Klaviyo",
    "title": "How to migrate your branded sending domain from a previous email service provider (ESP) to Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
