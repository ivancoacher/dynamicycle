    "name": "How to create Google service account to enable push notifications",
    "title": "How to create Google service account to enable push notifications",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:49:18Z",
