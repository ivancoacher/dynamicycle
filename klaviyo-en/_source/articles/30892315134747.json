    "name": "How to use the campaigns library",
    "title": "How to use the campaigns library",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:49:52Z",
