    "name": "How to enable onsite tracking for Shopify",
    "title": "How to enable onsite tracking for Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:45Z",
