    "name": "How to use unique coupon codes in SMS and MMS messages",
    "title": "How to use unique coupon codes in SMS and MMS messages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-04T15:58:01Z",
