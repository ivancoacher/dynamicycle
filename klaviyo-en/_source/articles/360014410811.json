    "name": "How to use Shopify Flow and the Klaviyo Connector",
    "title": "How to use Shopify Flow and the Klaviyo Connector",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-10-17T20:05:58Z",
