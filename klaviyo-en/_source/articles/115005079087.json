    "name": "How to update your account email and password in Klaviyo",
    "title": "How to update your account email and password in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-10-29T19:49:50Z",
