    "name": "How to port a number into Klaviyo",
    "title": "How to port a number into Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:28Z",
