    "name": "How to sync Shopify segments to Klaviyo",
    "title": "How to sync Shopify segments to Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-01T16:23:45Z",
    "user_segment_id": null,
