    "name": "How to personalize onsite content with Klaviyo’s group membership API",
    "title": "How to personalize onsite content with Klaviyo’s group membership API",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:46Z",
