    "name": "How to use custom CSS to style Klaviyo Reviews widgets",
    "title": "How to use custom CSS to style Klaviyo Reviews widgets",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:54Z",
