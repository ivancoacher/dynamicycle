        {
          "href": "https://help.klaviyo.com/hc/en-us/sections/49375348896539",
          "text": "Getting started with BigCommerce"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/19736852757915-How-to-remove-onsite-tracking-for-BigCommerce#h_01HD6Y5TJTTN89YPDGA5431VND",
          "text": "You will learn"
        },
        {
          "href": "https://help.klaviyo.com/hc/en-us/articles/19736852757915-How-to-remove-onsite-tracking-for-BigCommerce#h_01HD6Y5TJTWWDJ5AQRH329K37X",
          "text": "Before you begin"
