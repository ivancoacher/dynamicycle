    "name": "How to remove onsite tracking for BigCommerce",
    "title": "How to remove onsite tracking for BigCommerce",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-29T15:21:50Z",
