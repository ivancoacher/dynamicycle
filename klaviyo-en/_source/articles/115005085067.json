    "name": "How to cancel a scheduled or sending campaign",
    "title": "How to cancel a scheduled or sending campaign",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:48:25Z",
