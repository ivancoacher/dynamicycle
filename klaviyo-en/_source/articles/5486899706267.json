    "name": "How to integrate a headless Magento 2 setup",
    "title": "How to integrate a headless Magento 2 setup",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:04Z",
