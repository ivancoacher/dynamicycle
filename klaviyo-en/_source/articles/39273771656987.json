    "name": "How to set up coupons for Customer Hub",
    "title": "How to set up coupons for Customer Hub",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:45Z",
