    "name": "How to add an internal alert action to a flow",
    "title": "How to add an internal alert action to a flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-06-17T16:24:17Z",
