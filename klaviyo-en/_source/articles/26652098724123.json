    "name": "How to disclose reviewer incentives",
    "title": "How to disclose reviewer incentives",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:54Z",
