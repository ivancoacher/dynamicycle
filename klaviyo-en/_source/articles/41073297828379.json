    "name": "How to track RCS opens in Klaviyo",
    "title": "How to track RCS opens in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:39Z",
