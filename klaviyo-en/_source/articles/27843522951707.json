    "name": "How to use the preview panel for message personalization",
    "title": "How to use the preview panel for message personalization",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-27T18:00:01Z",
