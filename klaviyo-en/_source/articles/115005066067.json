    "name": "How to create a repeat purchaser segment",
    "title": "How to create a repeat purchaser segment",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-01-09T15:56:18Z",
