    "name": "How to sync Shopify account registration customers to a list",
    "title": "How to sync Shopify account registration customers to a list",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:31Z",
    "user_segment_id": null,
