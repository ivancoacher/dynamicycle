    "name": "Understanding WhatsApp per-user marketing limits",
    "title": "Understanding WhatsApp per-user marketing limits",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:47Z",
