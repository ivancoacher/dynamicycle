    "name": "How to use WooCommerce data in flows",
    "title": "How to use WooCommerce data in flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-04T19:20:38Z",
