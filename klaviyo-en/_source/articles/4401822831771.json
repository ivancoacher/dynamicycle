    "name": "Understanding SMS and MMS prohibited content",
    "title": "Understanding SMS and MMS prohibited content",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:17Z",
