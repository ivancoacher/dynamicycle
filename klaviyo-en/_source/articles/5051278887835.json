    "name": "How to use Klaviyo’s subject line assistant",
    "title": "How to use Klaviyo’s subject line assistant",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:51:16Z",
