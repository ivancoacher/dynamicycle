    "name": "How to create outbound tickets and log Phone Calls in Helpdesk",
    "title": "How to create outbound tickets and log Phone Calls in Helpdesk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:49Z",
