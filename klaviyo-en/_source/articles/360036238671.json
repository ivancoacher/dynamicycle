    "name": "How to A/B test flow SMS messages",
    "title": "How to A/B test flow SMS messages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:06Z",
