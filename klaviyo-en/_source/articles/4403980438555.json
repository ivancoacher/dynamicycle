    "name": "How to tell subscribers about a change in phone number",
    "title": "How to tell subscribers about a change in phone number",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:39Z",
