    "name": "How to add a tag to a list or segment",
    "title": "How to add a tag to a list or segment",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-12-01T08:00:06Z",
