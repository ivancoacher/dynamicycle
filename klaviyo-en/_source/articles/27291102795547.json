    "name": "How to collect, import, and display store reviews",
    "title": "How to collect, import, and display store reviews",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:49:40Z",
