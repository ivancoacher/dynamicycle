    "name": "How to sync reviews to Google Shopping",
    "title": "How to sync reviews to Google Shopping",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:48:55Z",
