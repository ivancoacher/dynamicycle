    "name": "How to remove SMS consent from a single profile",
    "title": "How to remove SMS consent from a single profile",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-05-25T13:42:51Z",
