    "name": "How to feature reviews in emails with the review quote block",
    "title": "How to feature reviews in emails with the review quote block",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:47Z",
