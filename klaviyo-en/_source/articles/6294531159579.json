    "name": "How to create a tap-to-text sticker on Instagram",
    "title": "How to create a tap-to-text sticker on Instagram",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:16Z",
