    "body": "<table>\n<tbody>\n<tr>\n<th style=\"text-align: left\">Dashboard</th>\n<th style=\"text-align: left\">Metric</th>\n<th style=\"text-align: left\">What It Shows</th>\n<th>Use Case</th>\n</tr>\n<tr>\n<td style=\"text-align: left\">Historical Daily Room Revenue from Stays</td>\n<td style=\"text-align: left\"><strong>Completed Room Night</strong></td>\n<td style=\"text-align: left\">Total room revenue per night</td>\n<td>View the revenue attributable to a given night</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">Average Daily Rate (ADR) from Stays</td>\n<td style=\"text-align: left\"><strong>Completed Room Night</strong></td>\n<td style=\"text-align: left\">Average nightly rate for historical stays </td>\n<td>View the average daily rate historically</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">ADR from New Bookings</td>\n<td style=\"text-align: left\"><strong>Confirmed Room Night</strong></td>\n<td style=\"text-align: left\">Average nightly rate for new bookings</td>\n<td>View the average daily rate for new bookings to understand the impact of marketing efforts</td>\n</tr>\n</tbody>\n</table>\n<table>\n<tbody>\n<tr>\n<th style=\"text-align: left\">Property</th>\n<th style=\"text-align: left\">What It Means</th>\n</tr>\n<tr>\n<td style=\"text-align: left\">$value</td>\n<td style=\"text-align: left\">The nightly room rate for that specific night</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">PropertyName</td>\n<td style=\"text-align: left\">The name of the property/hotel</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">Source</td>\n<td style=\"text-align: left\">Where the booking came from (e.g., Direct, Booking.com, Airbnb, Vrbo)</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">RoomTypeName</td>\n<td style=\"text-align: left\">The room type or name (e.g., Deluxe Queen, Presidential Suite)</td>\n</tr>\n<tr>\n<td style=\"text-align: left\">StartDate</td>\n<td style=\"text-align: left\">The calendar date the night begins</td>\n</tr>\n</tbody>\n</table>",
