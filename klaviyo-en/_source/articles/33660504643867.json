    "name": "How to display product recommendations in Customer Hub",
    "title": "How to display product recommendations in Customer Hub",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-13T20:02:10Z",
