    "name": "Understanding how Klaviyo monitors metric activity for flows",
    "title": "Understanding how Klaviyo monitors metric activity for flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-16T18:12:04Z",
