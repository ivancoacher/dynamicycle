    "name": "How to enable Smart Translations",
    "title": "How to enable Smart Translations",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:58:37Z",
