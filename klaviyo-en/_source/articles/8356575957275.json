    "name": "How to add or change a plan in Klaviyo",
    "title": "How to add or change a plan in Klaviyo",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:03:46Z",
