    "name": "How to use go-to-inbox buttons in forms",
    "title": "How to use go-to-inbox buttons in forms",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:52Z",
