    "name": "How to create an abandoned \"Added to Cart\" flow for Shopify",
    "title": "How to create an abandoned \"Added to Cart\" flow for Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-04-10T17:42:21Z",
    "user_segment_id": null,
