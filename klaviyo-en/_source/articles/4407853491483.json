    "name": "How profiles are added to and removed from lists",
    "title": "How profiles are added to and removed from lists",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:13Z",
