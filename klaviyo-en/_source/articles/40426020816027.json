    "name": "How to upload existing Magento 1 subscribers to a Klaviyo list",
    "title": "How to upload existing Magento 1 subscribers to a Klaviyo list",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:17Z",
