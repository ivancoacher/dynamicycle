    "name": "How to collect consent via Instagram",
    "title": "How to collect consent via Instagram",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-08-29T14:01:43Z",
