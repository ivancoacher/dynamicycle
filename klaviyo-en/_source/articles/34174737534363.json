    "name": "How to edit, turn off, or delete automations",
    "title": "How to edit, turn off, or delete automations",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-19T20:21:25Z",
