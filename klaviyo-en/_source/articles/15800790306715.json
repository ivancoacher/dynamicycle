    "name": "How to add SMS to a thank you flow",
    "title": "How to add SMS to a thank you flow",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-01-11T20:48:05Z",
