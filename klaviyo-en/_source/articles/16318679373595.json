    "name": "How to use SMS in replenishment flows",
    "title": "How to use SMS in replenishment flows",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-10-01T13:30:34Z",
