    "name": "How to use a coupon block in an email",
    "title": "How to use a coupon block in an email",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-17T13:54:35Z",
