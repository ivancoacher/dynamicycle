    "name": "How to use deep links in push notifications",
    "title": "How to use deep links in push notifications",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-16T18:12:03Z",
