    "name": "Understanding how third-party cookie updates affect Klaviyo tracking",
    "title": "Understanding how third-party cookie updates affect Klaviyo tracking",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:00:34Z",
