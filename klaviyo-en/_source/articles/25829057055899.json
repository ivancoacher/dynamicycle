    "name": "How to use account-level mapped metrics",
    "title": "How to use account-level mapped metrics",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:53Z",
