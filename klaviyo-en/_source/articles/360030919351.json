    "name": "How to sync data from Klaviyo to Shopify",
    "title": "How to sync data from Klaviyo to Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-11T19:04:46Z",
