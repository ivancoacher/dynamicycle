    "name": "How to set up OAuth for existing Magento 2 integrations",
    "title": "How to set up OAuth for existing Magento 2 integrations",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-03-17T14:56:53Z",
