    "name": "How to set up coupons for Magento 2",
    "title": "How to set up coupons for Magento 2",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-08-21T13:10:00Z",
