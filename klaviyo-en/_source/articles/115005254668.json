    "name": "How to remove out-of-stock items in flows for Magento 2",
    "title": "How to remove out-of-stock items in flows for Magento 2",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-08-27T15:19:06Z",
