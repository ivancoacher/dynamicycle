    "name": "How to collect SMS consent at checkout on BigCommerce",
    "title": "How to collect SMS consent at checkout on BigCommerce",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-20T18:14:58Z",
