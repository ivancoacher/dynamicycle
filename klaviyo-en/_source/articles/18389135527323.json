    "name": "How to send order updates via SMS for Shopify",
    "title": "How to send order updates via SMS for Shopify",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:55:48Z",
