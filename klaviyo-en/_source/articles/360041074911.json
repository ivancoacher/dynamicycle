    "name": "Understanding MMS image and GIF best practices",
    "title": "Understanding MMS image and GIF best practices",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-06-23T22:52:17Z",
