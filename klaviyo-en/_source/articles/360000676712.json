    "name": "How to calculate average order value (AOV)",
    "title": "How to calculate average order value (AOV)",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-06-16T13:20:47Z",
