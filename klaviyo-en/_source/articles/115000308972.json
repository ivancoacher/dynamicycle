    "name": "Understanding Klaviyo's anti-abuse and campaign performance monitoring",
    "title": "Understanding Klaviyo's anti-abuse and campaign performance monitoring",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-03-07T19:14:09Z",
