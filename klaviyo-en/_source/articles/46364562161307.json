    "name": "Skip to success in multi-step sign-up forms",
    "title": "Skip to success in multi-step sign-up forms",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:02:30Z",
