    "name": "Verify your Meta Business Portfolio for WhatsApp",
    "title": "Verify your Meta Business Portfolio for WhatsApp",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T00:59:02Z",
