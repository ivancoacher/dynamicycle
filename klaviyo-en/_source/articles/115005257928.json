    "name": "How to include a follow-up email to resend a campaign to \"non-openers\"",
    "title": "How to include a follow-up email to resend a campaign to \"non-openers\"",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
