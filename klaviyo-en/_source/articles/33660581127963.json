    "name": "Understanding how coupons work for Customer Hub",
    "title": "Understanding how coupons work for Customer Hub",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-03-13T20:02:10Z",
