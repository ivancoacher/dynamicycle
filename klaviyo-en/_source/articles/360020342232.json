    "name": "How to manually install Klaviyo.js for Shopify stores",
    "title": "How to manually install Klaviyo.js for Shopify stores",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-10-18T16:02:21Z",
