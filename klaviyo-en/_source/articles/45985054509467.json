    "name": "How to automatically sync website content for Customer Agent",
    "title": "How to automatically sync website content for Customer Agent",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-15T20:52:46Z",
