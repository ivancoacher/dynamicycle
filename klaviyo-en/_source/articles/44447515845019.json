    "name": "Understanding State Laws Limiting Frequency of Marketing Text Messages",
    "title": "Understanding State Laws Limiting Frequency of Marketing Text Messages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-17T01:01:53Z",
