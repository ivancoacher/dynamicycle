    "name": "How to personalize and export Shopify notification emails",
    "title": "How to personalize and export Shopify notification emails",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-02-28T15:13:28Z",
