    "name": "How to insert preview text into an email",
    "title": "How to insert preview text into an email",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-06-17T01:57:29Z",
