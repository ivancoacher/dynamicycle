    "name": "How to add a first name to an email, SMS, or push message",
    "title": "How to add a first name to an email, SMS, or push message",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2025-07-22T17:04:26Z",
