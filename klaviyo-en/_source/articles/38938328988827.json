    "name": "How to automatically forward support emails to Klaviyo Helpdesk",
    "title": "How to automatically forward support emails to Klaviyo Helpdesk",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-29T13:19:33Z",
