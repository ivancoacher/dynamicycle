    "name": "How to add a link that applies an item to a BigCommerce cart",
    "title": "How to add a link that applies an item to a BigCommerce cart",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2023-05-17T16:10:27Z",
    "user_segment_id": null,
