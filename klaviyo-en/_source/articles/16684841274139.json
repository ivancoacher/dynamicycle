    "name": "How to exclude products, orders, or customers from review requests",
    "title": "How to exclude products, orders, or customers from review requests",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2026-04-20T16:48:59Z",
