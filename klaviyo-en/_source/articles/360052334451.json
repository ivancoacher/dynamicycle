    "name": "How to update the domain settings for your hosted pages",
    "title": "How to update the domain settings for your hosted pages",
    "source_locale": "en-us",
    "locale": "en-us",
    "outdated": false,
    "outdated_locales": [],
    "edited_at": "2024-12-05T16:11:50Z",
